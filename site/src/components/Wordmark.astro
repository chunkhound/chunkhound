---
// Horizontal lockup — nav only. The hero no longer repeats the brand: it
// leads with the value prop and carries only an eyebrow-scale logo mark.
---

<span class="wordmark-brand">
    <span class="wordmark-logo-stack" aria-hidden="true">
        <img src="/logo.svg" alt="" class="wordmark-logo wordmark-logo-light" />
        <img
            src="/logo-light.svg"
            alt=""
            class="wordmark-logo wordmark-logo-dark"
        />
    </span>
    <span class="wordmark-text"
        >ChunkHound<span class="wordmark-dot" aria-hidden="true"></span></span
    >
</span>

<style>
    .wordmark-brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: "Inter", sans-serif;
        font-weight: 700;
        font-size: 18px;
        color: var(--text-primary);
    }

    @media (max-width: 420px) {
        .wordmark-brand {
            font-size: 16px;
        }
    }

    .wordmark-logo-stack {
        display: inline-grid;
        place-items: center;
        flex-shrink: 0;
        height: 1.4em;
        width: calc(1.4em * 194 / 150);
    }

    .wordmark-logo {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
    }

    .wordmark-logo-dark {
        display: none;
    }

    :global([data-theme="dark"]) .wordmark-logo-light {
        display: none;
    }

    :global([data-theme="dark"]) .wordmark-logo-dark {
        display: block;
    }

    .wordmark-text {
        position: relative;
        white-space: nowrap;
    }

    .wordmark-dot {
        display: inline-block;
        width: 0.14em;
        height: 0.14em;
        border-radius: 50%;
        background: var(--primary);
        margin-left: 1px;
        vertical-align: baseline;
    }
</style>
