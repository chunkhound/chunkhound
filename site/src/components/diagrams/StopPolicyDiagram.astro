---
/**
 * A crossed target is a queued stop, not a kill. The four steps are the whole
 * policy: the crossing call finishes, the stop waits, a checkpoint ends the run,
 * and its metadata survives as the partial result.
 */
import DiagramFigure from "./DiagramFigure.astro";
import DiagramNode from "./DiagramNode.astro";
---

<DiagramFigure
    caption="A soft stop lands on a checkpoint"
    label="How a cost or time target ends a workflow run"
    description="A guarded call crosses the target and still runs. The host arms a pending stop. The run continues to the next checkpoint, which ends it and saves that checkpoint metadata as the partial result. Cancellation is immediate and skips the queue."
>
    <div class="steps">
        <DiagramNode title="Guarded call" detail="the crossing effect runs" />
        <span class="arrow" aria-hidden="true">&rarr;</span>
        <DiagramNode title="Pending stop" detail="armed, not enforced" tone="accent" />
        <span class="arrow" aria-hidden="true">&rarr;</span>
        <DiagramNode title="Checkpoint" detail="the run ends here" />
        <span class="arrow" aria-hidden="true">&rarr;</span>
        <DiagramNode title="Partial result" detail="checkpoint metadata" />
    </div>
    <p class="d-note">Cancellation skips the queue: it aborts the active turn at once.</p>
</DiagramFigure>

<style>
    .steps {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: var(--space-3);
    }

    .arrow {
        color: var(--text-tertiary);
        font-size: var(--text-sm);
        line-height: 1;
    }

    @media (max-width: 720px) {
        .steps {
            grid-template-columns: 1fr;
        }

        .arrow {
            display: none;
        }
    }
</style>
