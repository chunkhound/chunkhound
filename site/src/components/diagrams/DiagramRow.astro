---
/**
 * One rail row: a labelled question on the left and the parts that answer it on
 * the right. Every row shares one left rail and one content column, so the
 * figure reads top to bottom as a single map.
 *
 * The anatomy lives in diagrams.css (.d-row*), not here: the enterprise page
 * writes the same markup as raw HTML, because a Markdown page cannot import a
 * component, and both must align identically.
 */
import DiagramNode from "./DiagramNode.astro";
import PhosphorIcon from "../PhosphorIcon.astro";

interface NodeSpec {
  title: string;
  detail?: string;
  tone?: "default" | "accent";
}

interface Props {
  label: string;
  caption: string;
  /** Phosphor tag, e.g. "ph-code". Registered by the consuming figure. */
  icon?: string;
  /** Quiet qualifier on the name line, e.g. "optional". */
  tag?: string;
  nodes: NodeSpec[];
}

const { label, caption, icon, tag, nodes } = Astro.props;
---

<section class="d-band d-row">
    <header class="d-row-rail">
        {icon && (
            <PhosphorIcon
                name={icon}
                size="20"
                weight="regular"
                aria-hidden="true"
                class="d-row-icon"
                data-tone="accent"
            />
        )}
        <span class="d-band-label d-row-label"
            >{label}{tag && <span class="rail-tag">{tag}</span>}</span
        >
        <span class="d-band-caption d-row-caption">{caption}</span>
    </header>
    <div class="d-row-lane">
        {nodes.map((node) => <DiagramNode {...node} />)}
    </div>
</section>

<style>
    /* A qualifier of the name, not a control: it reuses the diagram's ownership
       tag voice (small caps, tertiary, no fill) and drops the label's uppercase
       step, so it sits one rank below the name it modifies. */
    .rail-tag {
        margin-left: var(--space-2);
        color: var(--text-tertiary);
        font-size: var(--text-xs);
        font-weight: 400;
        letter-spacing: 0.04em;
        font-variant: small-caps;
        text-transform: none;
        white-space: nowrap;
    }
</style>
