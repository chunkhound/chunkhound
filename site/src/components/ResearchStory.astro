---
import KnowledgeCard from "./KnowledgeCard.astro";
import PhosphorIcon from "./PhosphorIcon.astro";
import FlowArrow from "./FlowArrow.astro";

const repoSources = [
  { icon: "ph-code", label: "Current code and call paths" },
  { icon: "ph-git-commit", label: "Git history and diffs" },
  { icon: "ph-tree-structure", label: "Architecture and project conventions" },
];

const webSources = [
  { icon: "ph-book-open-text", label: "Official docs and API references" },
  { icon: "ph-github-logo", label: "GitHub issues and release notes" },
  { icon: "ph-graduation-cap", label: "Tutorials and working examples" },
  { icon: "ph-chart-line-up", label: "Benchmarks and industry best practices" },
];
---

<script>
  import "@phosphor-icons/webcomponents/PhPlus";
</script>

<!-- The repo-and-web knowledge story: how the two knowledge halves merge into
     one cited answer. The question examples that this capability answers live
     in the sibling ResearchQuestions section. -->
<section id="research" class="research-story" aria-labelledby="research-heading">
  <div class="container">
    <header class="intro" data-reveal>
      <p class="eyebrow">THE WAY DEVELOPERS ACTUALLY WORK</p>
      <h2 id="research-heading">Give agents the codebase and the browser tab.</h2>
      <p>When developers get stuck, they trace the code, read the commit history and diffs, and search the web. ChunkHound lets agents do the same across your entire codebase, docs, GitHub issues, tutorials, benchmarks, and fixes buried online—then returns one answer with links back to every source.</p>
    </header>

    <div class="knowledge-grid">
      <div class="knowledge-slot" data-reveal="left">
        <KnowledgeCard label="INSIDE YOUR REPO" title="How your system actually works" sources={repoSources} />
      </div>

      <span class="merge-icon" data-reveal="pop" aria-hidden="true"><PhosphorIcon name="ph-plus" size="24" weight="bold" /></span>

      <div class="knowledge-slot" data-reveal="right">
        <KnowledgeCard label="OPEN IN THE BROWSER" title="What the rest of the engineering world knows" sources={webSources} />
      </div>
    </div>

    <p class="result flow-bar" data-reveal><span>One engineering question</span><FlowArrow /><strong>One cited answer grounded in both</strong></p>
  </div>
</section>

<script>
  import "../scripts/count-reveal.ts";
</script>

<style>
  .research-story { padding: var(--space-10) 0; }
  /* Left-anchored, spans the container (DESIGN_SYSTEM: one left-aligned system;
     section content carries no artificial measure cap). The wide column gap is
     deliberate breathing room around the merge "+" — it narrows both flanking
     cards on either side of the icon. */
  .knowledge-grid { align-items: stretch; display: grid; column-gap: var(--space-8); row-gap: var(--space-4); grid-template-columns: 1fr auto 1fr; margin: 0; }
  /* Reveal wrappers around KnowledgeCard: grid so the card still stretches. */
  .knowledge-slot { display: grid; }
  .merge-icon { align-items: center; align-self: center; background: var(--primary-bg); border-radius: var(--radius-full); color: var(--on-primary-bg); display: flex; height: var(--target-lg); justify-content: center; width: var(--target-lg); }
  /* Base recipe lives in global.css (.flow-bar). Stacking is a vertical flow,
     so the same rule flips the arrow down. */
  @media (max-width: 760px) { .knowledge-grid { grid-template-columns: 1fr; } .merge-icon { justify-self: center; } .result { --flow-glyph: "\2193"; align-items: stretch; flex-direction: column; } }
</style>
