---
import { COPY_SVG } from "../lib/shiki-config.js";

// Confirmation glyph. Shares the copy glyph's 18px slot so the state flip is a
// label swap, never a width change — status text in the flex row used to grow
// the pill on click and shrink it back on reset (2 layout shifts per copy).
const CHECK_SVG = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
    <path d="M173.66 98.34a8 8 0 0 1 0 11.32l-56 56a8 8 0 0 1-11.32 0l-24-24a8 8 0 0 1 11.32-11.32L112 148.69l50.34-50.35a8 8 0 0 1 11.32 0Z"></path>
    <path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88 88.1 88.1 0 0 1-88 88Z"></path>
  </svg>
`;

// Colour variant, not geometry: the shared .btn recipe (global.css) owns the
// control shape, so this field and the closing CTA cannot drift on radius or
// size. `page` = the theme-adaptive primary pair (white label in light, dark
// label in dark), used on a page surface; `quiet` = the outline copy field that
// must not compete with a CTA beside it.
interface Props {
  variant?: "page" | "quiet";
}
const { variant = "quiet" } = Astro.props;

const command = "uv tool install chunkhound";
---

<!-- The button IS the field. A separate icon-only button left the command text
     click-dead at an 18x18px target, far under the 44px Fitts' law floor.
     Rendering the button as the field root keeps copy-handler.js's contract
     intact: `.copy-btn[data-copy]` with an `.install-command` ancestor and a
     `[data-copy-status]` descendant. -->
<button
  type="button"
  class={`btn btn--lg btn--${variant} install-command copy-btn`}
  aria-label="Copy install command"
  data-copy={command}
>
  <code>{command}</code>
  <span class="copy-glyph" aria-hidden="true">
    <span class="glyph glyph-copy" set:html={COPY_SVG} />
    <span class="glyph glyph-check" set:html={CHECK_SVG} />
  </span>
  <!-- Announced, never rendered: copy failures must stay vocal, but the text
       must not occupy flex space or the pill resizes on every copy. -->
  <span class="copy-status sr-only" data-copy-status role="status" aria-live="polite"></span>
</button>

<style>
  /* Copy affordance and mono content only. Geometry (radius, size, padding) and
     palette come from the shared .btn recipe in global.css. */

  /* The click copies; text selection would be a competing gesture. */
  .install-command {
    user-select: none;
  }

  code {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    white-space: nowrap;
  }

  /* Fixed slot: both glyphs overlap in one grid cell, so the swap is
     geometrically free. */
  .copy-glyph {
    display: grid;
    flex-shrink: 0;
    height: 18px;
    place-items: center;
    width: 18px;
  }

  .glyph {
    display: block;
    grid-area: 1 / 1;
  }

  .glyph :global(svg) {
    display: block;
    height: 18px;
    width: 18px;
  }

  .glyph-check,
  .copied .glyph-copy {
    display: none;
  }

  .copied .glyph-check {
    display: block;
  }

  @media (max-width: 360px) {
    code {
      font-size: 12px;
    }
  }
</style>

<!-- The field is its own copy control, so it owns the copy listener rather than
     depending on whichever other copy surface happens to render on the page. -->
<script>
  import "../scripts/copy-handler.js";
</script>
