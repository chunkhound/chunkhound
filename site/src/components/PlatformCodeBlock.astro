---
import { DEFAULT_PLATFORM, PLATFORM_OPTIONS } from "./configurator/index.ts";
import { COPY_SVG } from '../lib/shiki-config.js';

interface Props {
    copyBtnId?: string;
    ariaLabel?: string;
    dataCopy?: string;
    class?: string;
    /** True only when the slot supplies one tabpanel per platform tab
        (ids `${idPrefix}-panel-<id>`). Single-panel blocks use switcher
        semantics (aria-pressed) so tabs never carry dangling aria-controls. */
    hasPanels?: boolean;
    /** Prefix for generated tab/panel IDs — must be unique per instance
        on the same page to avoid duplicate HTML IDs. */
    idPrefix?: string;
}

const { copyBtnId, ariaLabel = "Copy setup", dataCopy = "", class: className, hasPanels = false, idPrefix = "platform" } = Astro.props;
---

<div class:list={["platform-code-block", className]} data-platform-mode={hasPanels ? "tabs" : "switcher"}>
    <div class="code-header">
        <div class="platform-tabs" role={hasPanels ? "tablist" : "group"} aria-label="Choose your shell">
            {PLATFORM_OPTIONS.map((p) => (
                <button
                    role={hasPanels ? "tab" : undefined}
                    type="button"
                    id={`${idPrefix}-tab-${p.id}`}
                    aria-controls={hasPanels ? `${idPrefix}-panel-${p.id}` : undefined}
                    data-platform-option={p.id}
                    aria-selected={hasPanels ? p.id === DEFAULT_PLATFORM : undefined}
                    aria-pressed={!hasPanels ? p.id === DEFAULT_PLATFORM : undefined}
                    tabindex={p.id === DEFAULT_PLATFORM ? "0" : "-1"}
                    class="header-tab"
                >
                    {p.label}
                </button>
            ))}
        </div>
        <div class="copy-controls">
            <span class="copy-status" data-copy-status role="status" aria-live="polite"></span>
            <button type="button" class="copy-btn" id={copyBtnId} aria-label={ariaLabel} data-copy={dataCopy}>
                <span aria-hidden="true" set:html={COPY_SVG} />
                <span>Copy setup</span>
            </button>
        </div>
    </div>
    <slot />
</div>

<script>
// Pill interactivity (platform switching) is owned by
// scripts/configurator/platform-state.ts via configurator.ts — this script
// only wires the copy button, so the pills never get two controllers.
import '../scripts/copy-handler.js';
</script>

<style>
    .platform-code-block {
        position: relative;
        background: var(--code-bg);
        border: var(--border-w-default) solid var(--border-color);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .code-header {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        background: var(--bg-surface);
        border-radius: inherit;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom: var(--border-w-default) solid var(--border-color);
    }

    .platform-tabs {
        display: flex;
        align-items: stretch;
    }

    .header-tab {
        padding: 0 var(--space-4);
        height: 36px;
        background: transparent;
        border: none;
        border-bottom: var(--border-w-strong) solid transparent;
        color: var(--text-tertiary);
        font-size: var(--text-xs);
        font-weight: 600;
        font-family: inherit;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s;
    }

    .header-tab[aria-selected="true"],
    .header-tab[aria-pressed="true"] {
        color: var(--code-text);
        border-bottom-color: var(--primary);
    }

    .header-tab:hover {
        color: var(--text-secondary);
    }

    .copy-controls {
        padding-right: var(--space-1);
    }

    .copy-status {
        min-width: 3.5rem;
    }

    .copy-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        padding: 0 var(--space-2);
        border: none;
        border-radius: var(--radius-md);
        background: transparent;
        color: var(--text-tertiary);
        font: inherit;
        font-size: var(--text-xs);
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s, background 0.2s;
    }

    .copy-btn:hover {
        color: var(--text-secondary);
        background: var(--bg-muted);
    }

    .copy-btn.copied {
        color: var(--primary);
    }

    :global([data-theme="light"]) .platform-code-block {
        border-color: transparent;
    }

    :global([data-theme="light"]) .code-header {
        background: color-mix(in srgb, var(--code-text) 5%, var(--code-bg));
        border-bottom-color: color-mix(in srgb, var(--code-text) 6%, var(--code-bg));
    }

    :global([data-theme="light"]) .header-tab,
    :global([data-theme="light"]) .copy-btn {
        color: var(--code-muted);
    }

    :global([data-theme="light"]) .header-tab:hover,
    :global([data-theme="light"]) .copy-btn:hover {
        color: var(--code-text);
    }

    :global([data-theme="light"]) .copy-btn:hover {
        background: color-mix(in srgb, var(--code-text) 6%, transparent);
    }

    @media (prefers-color-scheme: light) {
        :global(:root:not([data-theme="dark"])) .platform-code-block {
            border-color: transparent;
        }

        :global(:root:not([data-theme="dark"])) .code-header {
            background: color-mix(in srgb, var(--code-text) 5%, var(--code-bg));
            border-bottom-color: color-mix(in srgb, var(--code-text) 6%, var(--code-bg));
        }

        :global(:root:not([data-theme="dark"])) .header-tab,
        :global(:root:not([data-theme="dark"])) .copy-btn {
            color: var(--code-muted);
        }

        :global(:root:not([data-theme="dark"])) .header-tab:hover,
        :global(:root:not([data-theme="dark"])) .copy-btn:hover {
            color: var(--code-text);
        }

        :global(:root:not([data-theme="dark"])) .copy-btn:hover {
            background: color-mix(in srgb, var(--code-text) 6%, transparent);
        }
    }

    .copy-btn :global(svg) {
        width: 18px;
        height: 18px;
    }

    .platform-code-block :global(pre) {
        margin: 0;
        padding: var(--space-4) var(--space-5);
        overflow-x: auto;
        background: transparent;
        border-radius: 0;
    }

    .platform-code-block :global(code) {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        color: var(--code-text);
        line-height: 1.6;
        white-space: pre;
        background: transparent;
    }

    @media (max-width: 768px) {
        .platform-code-block :global(pre) {
            padding: var(--space-3) var(--space-4);
        }

        .platform-code-block :global(code) {
            font-size: 12px;
        }
    }
</style>
