---
/** Shared wrapper for Phosphor web-component icons. Phosphor ships no
 * typings, so the name→element cast lives here instead of in every
 * consumer; renders as the custom element tag (e.g. <ph-code ...>).
 *
 * MUST forward the props it does not name. Astro passes the caller's scoped
 * style id as a `data-astro-cid-*` prop; dropping it leaves every scoped rule
 * aimed at the icon (`display`, `color`, `flex-shrink`, ...) unable to match,
 * because the element never carries the selector's scope attribute. */
import type { PhosphorIcon, PhosphorIconProps } from "../lib/phosphor-icon";

interface Props extends PhosphorIconProps {
  name: string;
  size: string;
  weight: string;
  class?: string;
}

const {
  name,
  size,
  weight,
  class: className,
  "aria-hidden": ariaHidden,
  ...attrs
} = Astro.props;
const Icon = name as unknown as PhosphorIcon;
---

<Icon size={size} weight={weight} class={className} aria-hidden={ariaHidden} {...attrs} />
