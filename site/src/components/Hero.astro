---
import positioning from "../lib/positioning.json";
// Terminal CSS is extracted: keep this component a template, not a stylesheet.
import "../styles/hero-terminal.css";

import { DEMO, callBeat } from "../scripts/hero-transcript";
import { noteForBeat } from "../scripts/hero-narrative";
import PhosphorIcon from "./PhosphorIcon.astro";
---

<!-- One full-bleed terminal surface: the section IS the terminal's backdrop. The
     h1 leads the surface (typography only — no eyebrow, no subheadline; the
     running demo is the explanation), then the install action, then the run's
     window: a decorative session-dot seam (which also carries the compact
     cards' glyph key) with the session control, the live run, and the composer,
     all in one framed object measured to the run itself. Each engine beat's
     marketing copy is a note anchored to the receipt it explains: it hangs
     inline below that receipt at every card width, railed, connected to the row
     it annotates and indented to the copy column. No second column, no light
     intro band. -->
<section class="hero">
    <div class="container">
        <div class="headline-row">
            {/* The trailing space (inside the h1) renders at the display
                size and collapses on wrap; the anchor hugs </h1> so no
                container-sized space dilutes it. */}
            <h1 class="headline">{positioning.headline}{" "}</h1><span
                class="hero-cta"
            ><span class="hero-hound" aria-hidden="true"></span><a
                class="hero-setup-link" href="/#configurator"
            >Build your hound{" "}<span aria-hidden="true">→</span></a
            ></span>
        </div>

        <div class="terminal-card">
            {/* The window: the titlebar, the scrollback and the composer in one
                bounded object, so the run reads as a terminal window on the
                hero's full-bleed surface. */}
            <div class="terminal-window">
                <div class="terminal-seam">
                    <div class="terminal-dots" aria-hidden="true">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                    </div>
                    {/* Glyph key: the compact cards collapse the transcript's
                        inline role column to buy back measure, so the glyph→role
                        mapping needs a home outside the run. It shares the seam row
                        with the session dots, so it costs no vertical space; screen
                        readers get the inline roles, so it is aria-hidden. */}
                    <ul class="terminal-key" aria-hidden="true">
                        <li class="terminal-key-item" data-key="agent">
                            <span class="terminal-key-glyph">⏺</span>
                            <span class="terminal-key-role">Agent</span>
                        </li>
                        <li class="terminal-key-item" data-key="chunkhound">
                            <span class="terminal-key-glyph">↳</span>
                            <span class="terminal-key-role">ChunkHound</span>
                        </li>
                    </ul>
                    {/* Session control: "Stop" while the auto-run is in flight (the
                        WCAG 2.2.2 mechanism for a run longer than five seconds),
                        "Replay" once it settles. It belongs to the window's
                        titlebar rather than the masthead: it is the session's one
                        control, so it sits at the titlebar's trailing edge — the
                        run's own right edge — and on a narrow card the headline
                        keeps its measure. */}
                    <button
                        type="button"
                        class="terminal-control"
                        data-state="replay"
                        aria-label="Replay demo"
                    >
                        <span
                            class="terminal-control-icon terminal-control-icon-play"
                            aria-hidden="true"
                        >
                            <PhosphorIcon name="ph-play" size="14" weight="fill" />
                        </span>
                        <span
                            class="terminal-control-icon terminal-control-icon-pause"
                            aria-hidden="true"
                        >
                            <PhosphorIcon name="ph-pause" size="14" weight="fill" />
                        </span>
                        <span class="terminal-control-label">Replay</span>
                    </button>
                </div>

                {/* tabindex: the short-viewport tier (max-height: 780px) makes
                    this region overflow-y: auto — keyboard users need focus to scroll. */}
                <div
                    class="terminal-viewport"
                    id="terminal-viewport"
                    role="region"
                    aria-label="Example AI agent conversation powered by ChunkHound"
                    tabindex="0"
                >
                    <div class="terminal-lines" id="terminal-lines">
                        {/* JS-on first paint stays empty (low-luminance surface)
                        until the entrance gate fires, so the transcript never
                        competes with the headline for the first fixation. The static
                        transcript lives in <noscript> so JS-off visitors still get
                        the full copy without a flash of it being cleared. Same DOM
                        structure as appendStaticStep(). */}
                        <noscript>
                            <div class="line user-prompt">
                                <span class="role-label"><span class="sr-only">You</span></span>
                                <span class="glyph">❯ </span>
                                <span class="prompt-text">{DEMO.prompt}</span>
                            </div>
                            {/* One beat group: the call and its receipt, then the
                                note that annotates them — so reading order is
                                call → receipt → note, matching how the annotation
                                hangs below the rows it explains. */}
                            {/* Notes resolve by beat, not positionally: a DEMO.calls
                                reorder must not silently desync the no-JS notes from
                                the live run (see noteForBeat). */}
                            {DEMO.calls.map((call, index) => {
                                const note = noteForBeat(callBeat(index));
                                if (!note) throw new Error(`hero demo call ${index} has no note`);
                                return (
                                <div class="anchor">
                                    <div class="line call">
                                        <span class="role-label"><span class="sr-only">Agent</span></span>
                                        <span class="glyph">⏺ </span>
                                        <span class="call-text">{call.call}</span>
                                    </div>
                                    <div class="line evidence">
                                        <span class="role-label"><span class="sr-only">ChunkHound</span></span>
                                        <span class="glyph">↳ </span>
                                        <span class="evidence-list">
                                            {call.sources.map((source) => (
                                                <span class="evidence-text">{source.kind}: {source.cite}</span>
                                            ))}
                                        </span>
                                    </div>
                                    <aside
                                        class="note"
                                        role="note"
                                        data-note={note.beats[0]}
                                        data-condition={note.condition}
                                    >
                                        <div class="note-head">
                                            <span class="note-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                                            <span class="note-kind">{note.label}</span>
                                            <span class="note-headline">{note.headline}</span>
                                        </div>
                                        <span class="note-detail">{note.detail}</span>
                                    </aside>
                                </div>
                                );
                            })}
                            <div class="line call">
                                <span class="role-label"><span class="sr-only">Agent</span></span>
                                <span class="glyph">⏺ </span>
                                <span class="call-text">{DEMO.synthesis}</span>
                            </div>
                            <div class="line answer">
                                <span class="role-label"><span class="sr-only">Agent</span></span>
                                <span class="glyph">✓ </span>
                                <span class="result">{DEMO.answer}</span>
                            </div>
                        </noscript>
                    </div>
                </div>

                {/* Composer row: the scrollback affordance + the fixed harness
                    input, on the same measure as the run it feeds — a composer
                    wider than the output it echoes reads as a different object.
                    The window's shared inline gutter keeps the pill and the input
                    on the run's edge at every width. */}
                <div class="terminal-composer">
                    {/* Scrollback affordance: visible only while the reader has
                        scrolled back off the tail; activating it resumes
                        tail-follow. Absolute so it never joins the composer's
                        flow. */}
                    <button
                        type="button"
                        class="terminal-jump"
                        aria-label="Jump to latest output"
                    >
                        <PhosphorIcon
                            name="ph-arrow-down"
                            size="12"
                            weight="bold"
                        />
                        <span>Latest</span>
                    </button>
                    {/* Fixed harness input: the visual anchor. Followup prompts
                        type here, then move up into the scrollback on send.
                        Always present (never scrolled, never re-created) so the
                        surface reads as a real agent TUI even before the run
                        starts. */}
                    <div class="terminal-input" id="terminal-input">
                        <span class="role-label"><span class="sr-only">You</span></span>
                        <span class="input-glyph" aria-hidden="true">❯</span>
                        <span class="input-line">
                            <span class="input-text" id="terminal-input-text"></span>
                            <span class="cursor" aria-hidden="true"></span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import "@phosphor-icons/webcomponents/PhArrowDown";
    import "@phosphor-icons/webcomponents/PhPause";
    import "@phosphor-icons/webcomponents/PhPlay";
    import "../scripts/hero-terminal.ts";
</script>
