---
import PhosphorIcon from "./PhosphorIcon.astro";
import { STAGES } from "../lib/architecture";

// The engine's five-stage pipeline — the homepage rail relocated to the page
// that explains it, so every technology is named with its icon in one place,
// grouped into its phase. Reranking and the LLM's follow-ups interleave inside
// the exploration phase, so their connectors are bidirectional (⇄), not a
// sequence. Monochrome glyphs, not filled chips: the diagrams.css restraint
// rule (no icons *inside diagrams*) still holds — this is a page-level band.
const groups = STAGES.reduce<{ phase: string; count: number }[]>((acc, stage) => {
  const last = acc[acc.length - 1];
  if (last?.phase === stage.phase) last.count += 1;
  else acc.push({ phase: stage.phase, count: 1 });
  return acc;
}, []);
let nextColumn = 1;
const phaseGroups = groups.map((group) => {
  const start = nextColumn;
  nextColumn += group.count;
  return { ...group, start };
});

// The phase band is aria-hidden, so screen readers get the grouping as a
// per-stage prefix instead of flat siblings. Derived from phaseGroups so the
// two can never disagree.
const phaseForStage = (index: number): string =>
  phaseGroups.find(
    (group) => index + 1 >= group.start && index + 1 < group.start + group.count,
  )?.phase ?? "";
---

<div class="engine-stages">
  <p class="engine-stages-label">The five stages</p>
  <div class="engine-stages-grid">
    <div class="engine-stages-phases" aria-hidden="true">
      {phaseGroups.map((group) => (
        <span style={`--start:${group.start}; --span:${group.count}`}>{group.phase}</span>
      ))}
    </div>
    <ol class="engine-stages-list" role="list" aria-label="The engine's pipeline stages">
      {STAGES.map((stage, index) => (
        <li style={`--start:${index + 1}`} role="listitem">
          <span class="sr-only">{phaseForStage(index)}: </span>
          <span class="engine-stage-icon" aria-hidden="true">
            <PhosphorIcon name={stage.icon} size="20" weight="duotone" />
          </span>
          <span class="engine-stage-title">{stage.title}</span>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  import "@phosphor-icons/webcomponents/PhCode";
  import "@phosphor-icons/webcomponents/PhCrosshair";
  import "@phosphor-icons/webcomponents/PhFunnel";
  import "@phosphor-icons/webcomponents/PhGraph";
  import "@phosphor-icons/webcomponents/PhArrowsMerge";
</script>

<style>
  /* Docs-surface band: grouping structure and type only (theme tokens). */
  .engine-stages {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border: var(--border-w-default) solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }
  .engine-stages-label {
    margin: 0 0 var(--space-3);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* One grid carries both the phase labels and the stages; each wrapper is
     display: contents, so spans and <li>s are direct grid items. Mobile then
     only swaps the axis — the same markup, transposed. */
  .engine-stages-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-3);
  }
  .engine-stages-phases,
  .engine-stages-list {
    display: contents;
  }
  /* Markers vanish with the <ol> box, so suppress them where they still exist. */
  .engine-stages-list {
    list-style: none;
  }
  /* Phase headers span the columns their stages occupy. */
  .engine-stages-phases span {
    grid-row: 1;
    grid-column: var(--start) / span var(--span);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }
  /* Pipeline: icons on one rail, connectors between them. */
  .engine-stages-list li {
    grid-row: 2;
    grid-column: var(--start);
    /* Prose list spacing (.docs-content li) must not leak into the diagram. */
    margin: 0;
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    color: var(--text-primary);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
    text-align: center;
  }
  /* The connector carries the sequence, so order survives a quick scan. Sized to
     the 20px icon rail (--text-lg) and given the icon accent so the five stages
     read as one flow rather than floating marks. */
  .engine-stages-list li + li::before {
    content: "→";
    position: absolute;
    left: calc(-1 * var(--space-4) / 2 - 0.45em);
    top: 0;
    color: var(--primary);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 20px;
  }
  /* Exploration interleaves retrieval, the LLM's follow-ups, and reranking —
     a loop, not a sequence. */
  .engine-stages-list li + li:nth-child(3)::before,
  .engine-stages-list li + li:nth-child(4)::before { content: "⇄"; }
  .engine-stage-icon {
    display: flex;
    height: 20px;
    color: var(--primary);
  }
  /* A steady two-line measure keeps the rail even across long stage names. */
  .engine-stage-title { max-width: 12ch; }
  /* Narrow: labels and arrows center on the full tile; the icon column centers
     in the gutter between the phase rail and the label column. `1fr /
     max-content / 1fr` makes the label track tile-centered; the left flank
     holds the rail and the icon. */
  @media (max-width: 640px) {
    .engine-stages-grid {
      --rail-w: 1rem;
      --icon-w: 1.25rem;
      position: relative;
      grid-template-columns: 1fr minmax(0, max-content) 1fr;
      column-gap: 0;
      row-gap: var(--space-5);
    }
    /* Phase rail: out of flow so the label words never stretch their rows, and
       centered on the group it spans. vertical-lr keeps the line left-aligned. */
    .engine-stages-phases span {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      grid-column: 1;
      grid-row: var(--start) / span var(--span);
      block-size: var(--rail-w);
      writing-mode: vertical-lr;
      text-align: start;
    }
    /* Each row spans every track and re-uses them via subgrid, so the icon and
       label land in the flank and label tracks. */
    .engine-stages-list li {
      grid-column: 1 / -1;
      grid-row: var(--start);
      display: grid;
      grid-template-columns: subgrid;
      gap: 0;
      align-items: center;
      justify-items: stretch;
      text-align: left;
      position: relative;
    }
    .engine-stage-icon {
      grid-column: 1;
      justify-self: start;
      /* Half the flank plus half the (rail − icon) delta centers the icon
         between the rail's right edge and the label's left edge. */
      margin-inline-start: calc(50% + (var(--rail-w) - var(--icon-w)) / 2);
    }
    .engine-stage-title {
      grid-column: 2;
      max-width: none;
      text-align: center;
    }
    .engine-stages-list li + li::before {
      content: "↓";
      /* The row spans the tile, so its center is the tile's center. */
      left: 50%;
      transform: translateX(-50%);
      top: calc(-1 * var(--space-5));
      line-height: var(--space-5);
      text-align: center;
    }
    /* The exploration interleave keeps its meaning: rotate ⇄, not downgrade. */
    .engine-stages-list li + li:nth-child(3)::before,
    .engine-stages-list li + li:nth-child(4)::before { content: "⇅"; }
  }
  /* Very narrow: cap the label so the icon gutter can never collapse, and keep
     every row two lines tall so wrapped labels stay even around the arrows. */
  @media (max-width: 340px) {
    .engine-stage-title { max-width: 16ch; }
    .engine-stages-grid { grid-auto-rows: minmax(2.5rem, auto); }
  }
  /* Narrow: room for the last rail label to hang below its single-row group. */
  @media (max-width: 640px) {
    .engine-stages { padding-bottom: var(--space-6); }
  }
</style>
