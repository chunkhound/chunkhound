---
import positioning from "../lib/positioning.json";
---

<!-- The closing act (StartHere) owns the install command, so the footer is the
     quiet sign-off: the ownership claim, the licence, and the community links.
     Splitting them this way is deliberate — the close states the act, the
     footer states the belief, so neither restates the other. -->
<footer class="site-footer" data-nav-mobile-inert>
  <div class="container">
    <div class="footer-meta">
      <div class="footer-claims">
        <p class="footer-signoff">{positioning.footerline}</p>
        <p class="footer-licence">MIT licensed &middot; Local-first</p>
      </div>
      <nav aria-label="Community links">
        <a href="https://github.com/chunkhound/chunkhound">GitHub</a>
        <a href="https://pypi.org/project/chunkhound/">PyPI</a>
        <a href="https://discord.gg/BAepHEXXnX">Discord</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-w-default) solid var(--border-subtle);
    padding: var(--space-7) 0 var(--space-6);
    text-align: start;
  }

  /* One row: claims on the start edge, community on the end edge; wraps to
     stacked on narrow viewports. */
  .footer-meta { align-items: baseline; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); justify-content: space-between; }
  .footer-signoff { color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--lh-sm); margin: 0; }
  .footer-licence { color: var(--text-tertiary); font-size: var(--text-sm); line-height: var(--lh-sm); margin: var(--space-2) 0 0; }
  .footer-meta nav { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .footer-meta a { color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--lh-sm); text-decoration: none; }
  .footer-meta a:hover { color: var(--text-primary); }
  .footer-meta a:focus-visible { outline: var(--border-w-emphasis) solid var(--link-focus); outline-offset: 3px; }
</style>
