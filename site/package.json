  "dependencies": {
    "@phosphor-icons/webcomponents": "^2.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "astro": "^7.3.1",
    "happy-dom": "^20.14.0",
    "tsx": "^4.8.1",
    "typescript": "^6.0.3"
  }
