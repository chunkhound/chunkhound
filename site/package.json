{
  "name": "chunkhound-site",
  "type": "module",
  "version": "0.0.1",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "generate:llms-txt": "node scripts/generate-llms-txt.mjs",
    "generate:og-images": "node scripts/generate-og-images.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "sync:readme-positioning": "node scripts/sync-readme-positioning.mjs",
